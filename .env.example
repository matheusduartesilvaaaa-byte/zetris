# Banco de dados PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/zetris?schema=public"

# Auth.js
AUTH_SECRET="gere-com-o-comando: openssl rand -base64 32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Login com Google (opcional — sem isso, o botão "Entrar com Google" fica inativo)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (Billing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_CORE="price_..."

# ZIA (Inteligência Artificial) — configure ao menos um provedor
AI_DEFAULT_PROVIDER="anthropic" # anthropic | openai | gemini | local
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# E-mail (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Zetris <noreply@zetris.com>"

# Cache e Filas — opcional. Sem isso, o sistema usa adaptadores em memória
# (funcionam, mas não compartilhados entre múltiplas instâncias).
REDIS_URL=""

# Forecast Engine — endpoint do futuro microserviço de ML (Prophet/ARIMA/LSTM)
FORECAST_ML_SERVICE_URL=""
