// ============================================================================
// ZETRIS CORE - PRISMA SCHEMA
// ============================================================================
// Arquitetura multiempresa: todo modelo de negócio carrega companyId.
// Nenhum dado é compartilhado entre empresas diferentes.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// AUTENTICAÇÃO & USUÁRIOS
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Administrador da PLATAFORMA Zetris (equipe interna), não da empresa do
  // cliente. Controla acesso ao painel /admin. Nunca confundir com
  // CompanyMember.role, que é o papel do usuário DENTRO de uma empresa.
  isPlatformAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   CompanyMember[]
  ownedCompanies Company[]      @relation("CompanyOwner")
  notifications Notification[]
  logs          Log[]

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Modelos padrão exigidos pelo Auth.js (NextAuth) com o Prisma Adapter
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------
// MULTIEMPRESA
// ----------------------------------------------------------------------------

model Company {
  id       String  @id @default(cuid())
  name     String
  cnpj     String? @unique
  logoUrl  String?
  address  String?
  city     String?
  state    String?
  zipCode  String?
  phone    String?
  email    String?

  ownerId String
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             CompanyMember[]
  settings            CompanySettings?
  subscription        Subscription?
  aiConversations     AiConversation[]
  emailLogs           EmailLog[]
  customers           Customer[]
  suppliers           Supplier[]
  categories          Category[]
  products            Product[]
  sales               Sale[]
  stockMovements      StockMovement[]
  accountsPayable     AccountPayable[]
  accountsReceivable  AccountReceivable[]
  cashFlowEntries     CashFlowEntry[]
  financialCategories FinancialCategory[]
  notifications       Notification[]
  logs                Log[]

  @@map("companies")
}

enum CompanyRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole @default(STAFF)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@map("company_members")
}

model CompanySettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  theme     String  @default("system") // light | dark | system
  currency  String  @default("BRL")
  locale    String  @default("pt-BR")
  timezone  String  @default("America/Sao_Paulo")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ----------------------------------------------------------------------------
// CLIENTES
// ----------------------------------------------------------------------------

model Customer {
  id        String  @id @default(cuid())
  companyId String

  name        String
  document    String? // CPF/CNPJ
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("customers")
}

// ----------------------------------------------------------------------------
// FORNECEDORES & CATEGORIAS
// ----------------------------------------------------------------------------

model Supplier {
  id        String @id @default(cuid())
  companyId String

  name    String
  document String?
  phone   String?
  email   String?
  address String?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("suppliers")
}

model Category {
  id        String @id @default(cuid())
  companyId String

  name String

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("categories")
}

// ----------------------------------------------------------------------------
// PRODUTOS
// ----------------------------------------------------------------------------

model Product {
  id        String @id @default(cuid())
  companyId String

  name         String
  sku          String?
  barcode      String?
  imageUrl     String?
  description  String?

  categoryId String?
  supplierId String?

  costPrice    Decimal @default(0) @db.Decimal(12, 2)
  salePrice    Decimal @default(0) @db.Decimal(12, 2)
  // margem calculada em runtime a partir de costPrice/salePrice

  stockQuantity Int @default(0)
  minStock      Int @default(0)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, sku])
  @@map("products")
}

// ----------------------------------------------------------------------------
// ESTOQUE
// ----------------------------------------------------------------------------

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  INVENTORY
}

model StockMovement {
  id        String @id @default(cuid())
  companyId String
  productId String

  type     StockMovementType
  quantity Int
  reason   String?

  relatedSaleId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([productId])
  @@map("stock_movements")
}

// ----------------------------------------------------------------------------
// VENDAS
// ----------------------------------------------------------------------------

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  BANK_TRANSFER
  OTHER
}

model Sale {
  id        String @id @default(cuid())
  companyId String

  customerId String?

  status        SaleStatus    @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id])
  items    SaleItem[]

  cashFlowEntry CashFlowEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(cuid())
  saleId String
  productId String

  quantity  Int
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

// ----------------------------------------------------------------------------
// FINANCEIRO
// ----------------------------------------------------------------------------

model FinancialCategory {
  id        String @id @default(cuid())
  companyId String

  name String
  type String // income | expense

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountsPayable     AccountPayable[]
  accountsReceivable  AccountReceivable[]
  cashFlowEntries     CashFlowEntry[]

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("financial_categories")
}

enum AccountStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model AccountPayable {
  id        String @id @default(cuid())
  companyId String

  description String
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      AccountStatus @default(PENDING)

  categoryId String?

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category FinancialCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("accounts_payable")
}

model AccountReceivable {
  id        String @id @default(cuid())
  companyId String

  description String
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  receivedAt  DateTime?
  status      AccountStatus @default(PENDING)

  categoryId String?

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category FinancialCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("accounts_receivable")
}

enum CashFlowType {
  INCOME
  EXPENSE
}

model CashFlowEntry {
  id        String @id @default(cuid())
  companyId String

  type        CashFlowType
  description String
  amount      Decimal      @db.Decimal(12, 2)

  categoryId String?
  saleId     String?      @unique

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category FinancialCategory? @relation(fields: [categoryId], references: [id])
  sale     Sale?              @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("cash_flow_entries")
}

// ----------------------------------------------------------------------------
// NOTIFICAÇÕES & LOGS
// ----------------------------------------------------------------------------

model Notification {
  id        String  @id @default(cuid())
  companyId String?
  userId    String

  title   String
  message String
  read    Boolean @default(false)
  type    String  @default("info") // info | warning | success | error

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model Log {
  id        String  @id @default(cuid())
  companyId String?
  userId    String?

  action  String
  entity  String?
  entityId String?
  metadata Json?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("logs")
}

// ----------------------------------------------------------------------------
// BILLING (Stripe) — isolado do restante do domínio de negócio
// ----------------------------------------------------------------------------

model Plan {
  id            String  @id @default(cuid())
  key           String  @unique // "core" | "pro" | "business" | "enterprise"
  name          String
  description   String?
  priceMonthly  Decimal @db.Decimal(10, 2)
  stripePriceId String? @unique
  isActive      Boolean @default(true)

  // Recursos liberados neste plano. Formato livre por enquanto
  // (ex: { "analytics.drill_down": true }); o Sprint 2 (Feature Flags)
  // formaliza o uso deste campo, sem precisar de migration nova
  // porque já é Json.
  features Json @default("{}")

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

model Subscription {
  id        String @id @default(cuid())
  companyId String @unique
  planId    String

  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique

  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id             String @id @default(cuid())
  subscriptionId String

  stripeInvoiceId  String?   @unique
  amount           Decimal   @db.Decimal(10, 2)
  status           String // paid | open | void | uncollectible
  hostedInvoiceUrl String?
  periodStart      DateTime?
  periodEnd        DateTime?
  paidAt           DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@map("invoices")
}

// Garante idempotência no processamento de webhooks do Stripe — o Stripe
// pode reenviar o mesmo evento mais de uma vez, e processá-lo duas vezes
// geraria auditoria e efeitos colaterais duplicados.
model WebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  processedAt   DateTime?
  payload       Json

  createdAt DateTime @default(now())

  @@map("webhook_events")
}

// ----------------------------------------------------------------------------
// ZIA (Inteligência Artificial) — arquitetura preparada para múltiplos provedores
// ----------------------------------------------------------------------------

enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
  LOCAL
}

model AiConversation {
  id        String @id @default(cuid())
  companyId String
  userId    String

  title    String?
  provider AiProvider @default(ANTHROPIC)

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@map("ai_conversations")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model AiMessage {
  id             String @id @default(cuid())
  conversationId String

  role       AiMessageRole
  content    String        @db.Text
  toolName   String?
  tokensUsed Int?

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

// ----------------------------------------------------------------------------
// E-MAIL — auditoria de envio, desacoplado do provedor
// ----------------------------------------------------------------------------

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model EmailLog {
  id        String  @id @default(cuid())
  companyId String?

  to       String
  template String
  status   EmailStatus @default(QUEUED)
  error    String?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("email_logs")
}
